Meta.DisplayName=OpenGGF Multiplayer Master
Meta.Description=OpenGGF multiplayer master server (room browser, relay rooms, recording uploads)
Meta.OS=Linux
Meta.AarchSupport=Unsupported
Meta.Arch=x86_64
Meta.Author=OpenGGF
Meta.URL=https://github.com/OpenGGF/OpenGGF
